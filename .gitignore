# Bundled embeddable CPython (download via scripts/fetch-runtime.ps1)
/runtime/

# Last zip self-update commit (not used when this folder is a git clone)
.self-update-sha

# Machine-local extras (not shipped; self-update leaves this dir alone)
/local/

# Staging / work product (local runs)
/jars/
/backup*/
