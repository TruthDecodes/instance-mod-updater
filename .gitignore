manifest.json
pack-*.json
neoforge-*-installer.jar

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Secrets (never commit)
.env
.env.*
*.pem
*.key
*.ed25519

# Built release zips (signed copies live on GitHub Releases)
/dist/

